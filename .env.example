# Hood Sniper — burner wallet only. Fund with trading float, nothing more.
# This file is a TEMPLATE. Copy to .env and never commit .env.
#
#   cp .env.example .env
#
# The executor refuses to arm unless HOOD_SNIPER_PRIVATE_KEY is set AND
# HOOD_SNIPER_ARMED=1 is passed explicitly on the command line.
HOOD_SNIPER_PRIVATE_KEY=
# Optional: assert the key derives to this address, so a wrong key fails loudly
# instead of trading from an account you did not intend.
HOOD_SNIPER_EXPECT_ADDRESS=
